rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDefaultGroup(groupId) {
      return groupId == "default_fitbuddies_group";
    }

    function hasDefaultGroupId(data) {
      return data.defaultGroupId == "default_fitbuddies_group" ||
        data.groupId == "default_fitbuddies_group" ||
        data.id == "default_fitbuddies_group";
    }

    match /__connection_checks/status {
      allow get: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        hasDefaultGroupId(request.resource.data);
      allow update: if isOwner(userId) &&
        resource.data.uid == userId &&
        request.resource.data.uid == userId &&
        hasDefaultGroupId(request.resource.data);
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        isDefaultGroup(groupId) &&
        hasDefaultGroupId(request.resource.data);
      allow delete: if false;

      match /members/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) &&
          isDefaultGroup(groupId) &&
          request.resource.data.userId == userId &&
          hasDefaultGroupId(request.resource.data);
        allow update: if isOwner(userId) &&
          isDefaultGroup(groupId) &&
          resource.data.userId == userId &&
          request.resource.data.userId == userId &&
          hasDefaultGroupId(request.resource.data);
        allow delete: if false;
      }

      match /dailyLogs/{document=**} {
        allow read, write: if false;
      }

      match /weeklyScores/{document=**} {
        allow read, write: if false;
      }

      match /monthlyScores/{document=**} {
        allow read, write: if false;
      }

      match /challenges/{document=**} {
        allow read, write: if false;
      }

      match /awards/{document=**} {
        allow read, write: if false;
      }

      match /userAwards/{document=**} {
        allow read, write: if false;
      }
    }

    match /dailyLogs/{document=**} {
      allow read, write: if false;
    }

    match /weeklyScores/{document=**} {
      allow read, write: if false;
    }

    match /monthlyScores/{document=**} {
      allow read, write: if false;
    }

    match /challenges/{document=**} {
      allow read, write: if false;
    }

    match /awards/{document=**} {
      allow read, write: if false;
    }

    match /userAwards/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
